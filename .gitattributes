* text=auto eol=lf

# NIST's CONTAM sample files are redistributed UNCHANGED (see tests/data/contam/NOTICE.md)
# and ContamX reads them byte for byte, so keep git's end-of-line normalisation away from
# them: a checkout on any platform must be the file NIST shipped.
tests/data/contam/* -text

# The street fixtures include float32 binaries (tests/data/street/*/NOTICE.md) read byte
# for byte: keep end-of-line normalisation away from them too.
tests/data/street/** -text

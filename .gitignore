# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.venv/
venv/
.env
.env.*

# Editors
.vscode/
.idea/
*.swp

# Claude Code local state (worktrees, settings) -- never part of the tracked tree
.claude/
.worktrees/

# Data: never commit measurements
data/
# ... except the test fixtures. `data/` matches ANY directory named `data`, tests/ included,
# and git never descends into an excluded directory -- so `tests/data/` must be re-included
# HERE, before the per-extension rules below, or the `!tests/data/*.csv` exception (and every
# .prj/.wth/.ctm fixture under tests/data/contam/) is silently dead.
!tests/data/
*.parquet
*.feather
*.h5
*.hdf5
*.csv
# `*.csv` above is a flat pattern -- it does not recurse, so `!tests/data/*.csv` alone
# only re-includes CSVs directly under `tests/data/`, not nested fixture subdirectories
# like `tests/data/wsimod/`. `**/*.csv` covers both.
!tests/data/*.csv
!tests/data/**/*.csv

# Notebooks: strip outputs before committing
*.ipynb_checkpoints/

# Benchmark scratch output
benchmarks_stderr.log

# MkDocs build output (`mkdocs build` writes here; the site is published from CI).
/site/

# SDD plan workspaces (ledgers, briefs, review packages)
.superpowers/

PC8 2 0.25
PC8 4 0.15

[TIMESERIES]
TS6 0:00 0.2
TS6 0:10 1.0
TS6 0:20 0.4

[INFLOWS]
J1   FLOW "" FLOW 1.0 1.0 0.2
J2   FLOW "" FLOW 1.0 1.0 0.25
J3   FLOW "" FLOW 1.0 1.0 0.3
J4   FLOW "" FLOW 1.0 1.0 0.15
J5   FLOW "" FLOW 1.0 1.0 0.25
J6   FLOW "" FLOW 1.0 1.0 0.25
J7   FLOW "" FLOW 1.0 1.0 0.12
J8   FLOW "" FLOW 1.0 1.0 0.2

[CONTROLS]
RULE R1a
IF NODE W1 DEPTH > 0.8
AND SIMULATION TIME > 00:01:00
THEN PUMP P1 STATUS = ON
RULE R1b
IF NODE W1 DEPTH < 0.2
THEN PUMP P1 STATUS = OFF

RULE R2
IF NODE W2 DEPTH > 1.0
THEN ORIFICE OR2 SETTING = 1.0
ELSE ORIFICE OR2 SETTING = 0.3

RULE R3
IF NODE W3 DEPTH < 0.7
OR SIMULATION MONTH <> 1
THEN WEIR WR3 SETTING = 0.5
ELSE WEIR WR3 SETTING = 1.0

RULE R4
IF NODE W4 DEPTH > 0.02
THEN PUMP P4 SETTING = CURVE CC4

RULE R5a
IF NODE W5 DEPTH > 0.3
THEN PUMP P5 SETTING = 0.5
PRIORITY 1
RULE R5b
IF NODE W5 DEPTH > 0.5
THEN PUMP P5 SETTING = 1.0
PRIORITY 2
RULE R5c
IF NODE W5 DEPTH > 0.2
THEN PUMP P5 SETTING = 0.0
PRIORITY 0

RULE R6
IF SIMULATION TIME >= 00:00:00
THEN ORIFICE OR6 SETTING = TIMESERIES TS6

RULE R7
IF NODE W7 DEPTH <> 0.9
THEN ORIFICE OR7 SETTING = PID 0.5 0.0 0.0

RULE R8a
IF NODE W8 HEAD > 11.0
THEN PUMP P8 STATUS = ON
RULE R8b
IF PUMP P8 TIMEOPEN > 00:02:00
AND NODE W8 DEPTH < NODE J8 DEPTH
THEN PUMP P8 STATUS = OFF
PRIORITY 1
RULE R8c
IF LINK C8 FLOW < 0.15
AND PUMP P8 STATUS = OFF
AND NODE W8 VOLUME > 20
THEN PUMP P8 STATUS = ON


[REPORT]
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS NONE
NODES ALL
LINKS ALL

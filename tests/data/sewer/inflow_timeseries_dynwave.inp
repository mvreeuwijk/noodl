[TITLE]
;;Project Title/Notes
Tree with time-series inflows (inline dated, inline hours, FILE), SI, dynamic wave - noodl test fixture

[OPTIONS]
;;Option             Value
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           01/01/2026
START_TIME           06:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    06:00:00
END_DATE             01/01/2026
END_TIME             06:10:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:01:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         10

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           500
HEAD_TOLERANCE       1e-12
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
;;-------------- ----------------
CONSTANT         0.0
DRY_ONLY         NO

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
;;-------------- ---------- ---------- ---------- ---------- ----------
J1               12.0       5          0          0          0
J2               12.0       5          0          0          0
J5               11.0       5          0          0          0
J3               10.0       5          0          0          0
J4               9.0        5          0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
;;-------------- ---------- ---------- ---------------- -------- ----------------
Outfall          8.0        FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
;;-------------- ---------------- ---------------- ---------- ---------- ---------- ---------- ---------- ----------
C1               J1               J3               200        0.013      0          0          0          0
C2               J2               J3               200        0.013      0          0          0          0
C3               J3               J4               200        0.013      0          0          0          0
C4               J5               J4               200        0.013      0          0          0          0
C5               J4               Outfall          200        0.013      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert
;;-------------- ------------ ---------------- ---------- ---------- ---------- ---------- ----------
C1               CIRCULAR     0.30             0          0          0          1
C2               CIRCULAR     0.30             0          0          0          1
C3               CIRCULAR     0.45             0          0          0          1
C4               CIRCULAR     0.30             0          0          0          1
C5               CIRCULAR     0.45             0          0          0          1

[INFLOWS]
;;Node           Constituent      Time Series      Type     Mfactor  Sfactor  Baseline Pattern
;;-------------- ---------------- ---------------- -------- -------- -------- -------- --------
J1               FLOW             Hyd1             FLOW     1.0      1.0      0
J2               FLOW             Hyd2             FLOW     1.0      2.0      0.01
J5               FLOW             Hyd3File         FLOW     1.0      1.0      0.002

[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------
;; Hyd1: dated, several entries per line and a date carried to the later lines
Hyd1             01/01/2026 06:01:00   0.0  06:03:00 0.02  06:04:30 0.07
Hyd1             06:06:00 0.03  06:08:00 0.05  06:09:00 0.0
;; Hyd2: no dates, decimal hours since the start of the simulation (06:00:00 here);
;; scaled by Sfactor 2 and added to the baseline 0.01
Hyd2             0        0.0
Hyd2             0.05     0.01
Hyd2             0.1      0.025
Hyd2             0.12     0.0
Hyd2             0.15     0.03
;; Hyd3File: read from a file next to this one
Hyd3File         FILE     inflow_series_j5.dat


[REPORT]
;;Reporting Options
INPUT      NO
CONTROLS   NO
SUBCATCHMENTS NONE
NODES ALL
LINKS ALL

[TAGS]

[MAP]
DIMENSIONS 0.000 0.000 1000.000 1000.000
Units      None

[COORDINATES]
;;Node           X-Coord            Y-Coord
;;-------------- ------------------ ------------------
J1               0                  200
J2               0                  100
J5               100                50
J3               100                150
J4               200                100
Outfall          300                100

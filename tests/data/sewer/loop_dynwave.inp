[TITLE]
;;Project Title/Notes
Loop with an adverse conduit (Cd, J3 9.60 m to J4 9.65 m, reversed by SWMM) - noodl dynamic-wave test fixture
Inflows J1 0.02, J3 0.005 m3/s: half of 0.04/0.01, which surcharge J3 (Cb, Cd) within 10 min

[OPTIONS]
;;Option             Value
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             00:30:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         5

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           500
HEAD_TOLERANCE       1e-12
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5

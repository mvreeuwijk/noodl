[TITLE]
;;Project Title/Notes
Minimal dendritic gravity network, constant inflow, SI units, dynamic wave - noodl test fixture
Ponding (ALLOW_PONDING YES): J2 (MaxDepth 0.3 = its crown, Aponded 0.5 m2) ponds from step 21 instead of flooding; J3 (MaxDepth 0.6, Aponded 0.5 m2) never reaches its rim. Inflows J1 0.075, J2 0.12, J5 0.045 m3/s: 3x tree_dynwave.inp, SURCHARGE_METHOD EXTRAN - noodl test fixture

[OPTIONS]
;;Option             Value
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        YES
SURCHARGE_METHOD     EXTRAN
SKIP_STEADY_STATE    NO

START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             00:30:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:05:00
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         5

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           500
HEAD_TOLERANCE       1e-12
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
;;-------------- ----------------
CONSTANT         0.0
DRY_ONLY         NO


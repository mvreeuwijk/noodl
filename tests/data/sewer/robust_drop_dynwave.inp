[TITLE]
;;Project Title/Notes
Head-solve robustness, noodl test fixture: a steep drop of 20 m into a flat, dry chain, wetted
by a ramped inflow (dry junctions meet the stiff bed below their inverts while a fast flow
arrives from above).

[OPTIONS]
;;Option             Value
FLOW_UNITS           CMS
INFILTRATION         HORTON
FLOW_ROUTING         DYNWAVE
LINK_OFFSETS         DEPTH
MIN_SLOPE            0
ALLOW_PONDING        NO
SKIP_STEADY_STATE    NO

START_DATE           01/01/2026
START_TIME           00:00:00
REPORT_START_DATE    01/01/2026
REPORT_START_TIME    00:00:00
END_DATE             01/01/2026
END_TIME             00:05:00
SWEEP_START          01/01
SWEEP_END            12/31
DRY_DAYS             0
REPORT_STEP          00:00:10
WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         5

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           500
HEAD_TOLERANCE       1e-12
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5
MINIMUM_STEP         0.5
THREADS              1

[EVAPORATION]
;;Data Source    Parameters
;;-------------- ----------------
CONSTANT         0.0
DRY_ONLY         NO

[JUNCTIONS]
;;Name           Elevation  MaxDepth   InitDepth  SurDepth   Aponded
;;-------------- ---------- ---------- ---------- ---------- ----------
J1               25.0       3.0        0          0          0
J2               25.0       3.0        0          0          0
J3               3.0        25.0       0          0          0
J4               3.0        3.0        0          0          0
J5               3.0        3.0        0          0          0
J6               3.0        3.0        0          0          0

[OUTFALLS]
;;Name           Elevation  Type       Stage Data       Gated    Route To
;;-------------- ---------- ---------- ---------------- -------- ----------------
O1               3.0        FREE                        NO

[CONDUITS]
;;Name           From Node        To Node          Length     Roughness  InOffset   OutOffset  InitFlow   MaxFlow
;;-------------- ---------------- ---------------- ---------- ---------- ---------- ---------- ---------- ----------
C1               J1               J2               30         0.011      0          0          0          0
C2               J2               J3               30         0.011      0          0          0          0
C3               J3               J4               30         0.011      0          0          0          0
C4               J4               J5               30         0.011      0          0          0          0
C5               J5               J6               30         0.011      0          0          0          0
C6               J6               O1               30         0.011      0          0          0          0

[XSECTIONS]
;;Link           Shape        Geom1            Geom2      Geom3      Geom4      Barrels    Culvert
;;-------------- ------------ ---------------- ---------- ---------- ---------- ---------- ----------
C1               CIRCULAR     0.6              0          0          0          1
C2               CIRCULAR     0.6              0          0          0          1
C3               CIRCULAR     0.6              0          0          0          1
C4               CIRCULAR     0.6              0          0          0          1
C5               CIRCULAR     0.6              0          0          0          1
C6               CIRCULAR     0.6              0          0          0          1

[INFLOWS]
;;Node           Constituent      Time Series      Type     Mfactor  Sfactor  Baseline Pattern
;;-------------- ---------------- ---------------- -------- -------- -------- -------- --------
J1               FLOW             Ramp             FLOW     1.0      1.0

[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------
Ramp                        0:00       0.0
Ramp                        0:01       0.0
Ramp                        0:02       0.15
Ramp                        1:00       0.15


WET_STEP             00:01:00
DRY_STEP             00:01:00
ROUTING_STEP         5

INERTIAL_DAMPING     PARTIAL
NORMAL_FLOW_LIMITED  BOTH
FORCE_MAIN_EQUATION  H-W
VARIABLE_STEP        0
LENGTHENING_STEP     0
MIN_SURFAREA         0
MAX_TRIALS           500
HEAD_TOLERANCE       1e-12
SYS_FLOW_TOL         5
LAT_FLOW_TOL         5

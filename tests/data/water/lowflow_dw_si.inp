 P2              	J1              	J2              	400         	50          	0.05        	0           	Open  	;
 P3              	J2              	J3              	300         	50          	0.05        	0           	Open  	;
 P4              	J1              	J3              	500         	40          	0.05        	0           	Open  	;
 P5              	J3              	J4              	300         	50          	0.05        	2           	Open  	;
 P6              	J4              	J5              	200         	25          	0.05        	0           	Open  	;

